# =============================================================================
# Defaults locais do k8s-blueprint (Make)
# =============================================================================
# Copie nesta pasta:
#   cp env/.env.example env/.env
#
# O Makefile carrega env/.env com -include (gitignored).
# A linha de comando continua a ter prioridade: make up OVERLAY=broetec-storage
# =============================================================================

# --- Inventário / overlay ------------------------------------------------------
# Overlay activo (default: broetec-core @ 10.20.30.40)
OVERLAY=broetec-core
# Opcional: sobrescreve a VM do overlay ao correr make inventory
# VM_NAME=broetec-core
# VM_IP=10.20.30.40
KVM_NETWORK=broetec-lab
# LAB_PATH=./lab

# --- Golden image (make golden) -----------------------------------------------
# true (default): VMs novas clonam lab/cache/golden-*.qcow2 quando existir e
#                 saltam o dnf update + reboot do role 02.
# false: clona sempre a imagem Rocky crua.
# USE_GOLDEN=true

# --- Host KVM (role 00) --------------------------------------------------------
# true (default): instala pacotes libvirt no host (Fedora/RHEL mutável),
# adiciona o utilizador aos grupos libvirt+kvm e prepara SELinux em lab/.
# Depois do primeiro setup-host: re-login (nova sessão) antes de make up.
# false: só rede libvirt — use se o host já tem KVM instalado
#        (ex.: Silverblue/immutable, ou servidor já preparado).
KVM_HOST_BOOTSTRAP=true

# false (default): não altera firewall do host.
# true: detecta firewalld/ufw/iptables activo e aplica regras NAT/FORWARD
#       para VMs lab (necessário em hosts com Docker + firewall activo).
KVM_HOST_FIREWALL=false

# --- Ansible / Python ----------------------------------------------------------
ANSIBLE_FORKS=1
UV_PYTHON=3.14

# --- Kubernetes bootstrap (role 04) --------------------------------------------
# O `make up`/`make deploy-k8s` gera a chave BYOK do Sealed Secrets em
# env/<overlay>/ e sela os Secrets do overlay offline (nada de kubeseal externo).
# As chaves ficam só localmente (env/* é gitignored).
#
# Fonte lida pelo Argo CD: vazio = o que o overlay declara (padrão `local`, o
# Git servido pela própria VM). `remote` usa o repoURL commitado (GitHub).
# ARGO_SOURCE=remote
#
# Emissor TLS do Gateway: vazio = o que o overlay declara. Um emissor
# letsencrypt-* precisa do token Cloudflare em
# k8s/core/cert-manager/overlays/<overlay>/api-token-secret.yaml; sem o token o
# role 04 usa `selfsigned`.
# TLS_ISSUER=selfsigned

# --- Fluxos Make (referência) --------------------------------------------------
# 1ª vez (role 00): make setup-host
# Uma VM:         make up                          # broetec-core (default)
# Outra VM:       make up OVERLAY=broetec-storage
# Todas as VMs:   make up-all
# Só k8s:         make deploy OVERLAY=broetec-core
# Sem bootstrap:  KVM_HOST_BOOTSTRAP=false em env/.env (ou na linha de comando)

# --- SSH no controlador --------------------------------------------------------
# false (default): só ~/.ssh/known_hosts + env/ssh_config_lab (make ensure-user-known-hosts)
# true: criar /etc/ssh/ssh_known_hosts vazio no controlador (sudo, opt-in)
CREATE_SSH_GLOBAL_KNOWN_HOSTS=false

# libssh (default) | ssh (OpenSSH — pode causar worker dead no terminal do Cursor)
ANSIBLE_VM_CONNECTION=libssh

# false (default): Make gere chaves via ssh-host-key-refresh; true: site.yml faz ssh-keygen -R
ANSIBLE_PRUNE_SSH_KNOWN_HOSTS=false
