# Gerar o hash bcrypt:
#   htpasswd -nbBC 10 "" 'your-password' | tr -d ':\n' | sed 's/$2y/$2a/'
#
# Selar o secret:
# kubeseal --format yaml --cert sealed-secrets/overlays/dev/dev-pub.pem < \
# argocd/overlays/dev/admin-secret.yaml > \
# argocd/overlays/dev/admin-sealedsecret.yaml
#
# A annotation "patch: true" faz merge no argocd-secret existente (criado pelo Helm),
# sem apagar campos como server.secretkey.
---
apiVersion: v1
kind: Secret
metadata:
  name: argocd-secret
  namespace: argocd
  annotations:
    sealedsecrets.bitnami.com/patch: "true"
stringData:
  admin.password: "$2a$10$REPLACE_WITH_BCRYPT_HASH"
  admin.passwordMtime: "2026-01-01T00:00:00Z"
