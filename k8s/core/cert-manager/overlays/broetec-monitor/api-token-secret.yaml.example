# Token da API Cloudflare para os ClusterIssuers letsencrypt-* (DNS-01).
#
#   cp api-token-secret.yaml.example api-token-secret.yaml   # gitignored
#   # preencha o token (permissão Zone > DNS > Edit na zona do domínio)
#   make deploy-k8s OVERLAY=broetec-monitor
#
# O role 04 aplica este Secret direto no cluster. Sem o arquivo, o Gateway usa o
# emissor `selfsigned` naquele deploy.
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
type: Opaque
stringData:
  api-token: "SEU_CLOUDFLARE_API_TOKEN"