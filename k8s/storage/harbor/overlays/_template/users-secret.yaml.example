# Segredo de laboratório: `k8s-blueprint secrets init -o [[ overlay_id ]]` (ou o
# role 04) gera o *-secret.yaml com valores aleatórios guardados em
# env/[[ overlay_id ]]/lab-secrets.yml e o sela com a chave BYOK do overlay.
# Para usar valores próprios, crie o *-secret.yaml à mão antes do deploy.
# Senha do admin: `k8s-blueprint secrets show -o [[ overlay_id ]] harbor-admin-password`.
apiVersion: v1
kind: Secret
metadata:
  name: users-secret
  namespace: harbor
type: Opaque
stringData:
  HARBOR_ADMIN_PASSWORD: <lab:harbor-admin-password:24>
  PULLER_ROBOT_PASSWORD: <lab:harbor-puller-robot-password:32>
  PUSHER_ROBOT_PASSWORD: <lab:harbor-pusher-robot-password:32>
