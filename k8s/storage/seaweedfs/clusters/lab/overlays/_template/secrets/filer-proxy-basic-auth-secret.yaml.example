# Segredo de laboratório: `k8s-blueprint secrets init -o [[ overlay_id ]]` (ou o
# role 04) gera o *-secret.yaml com valores aleatórios guardados em
# env/[[ overlay_id ]]/lab-secrets.yml e o sela com a chave BYOK do overlay.
# Para usar valores próprios, crie o *-secret.yaml à mão antes do deploy.
# Usuário `admin`; a senha fica em env/[[ overlay_id ]]/lab-secrets.yml
# (`k8s-blueprint secrets show -o [[ overlay_id ]] filer-password`).
apiVersion: v1
kind: Secret
metadata:
  name: seaweedfs-lab-filer-proxy-basic-auth
  namespace: seaweedfs
type: Opaque
stringData:
  .htpasswd: |
    admin:<lab-htpasswd:filer-password>
