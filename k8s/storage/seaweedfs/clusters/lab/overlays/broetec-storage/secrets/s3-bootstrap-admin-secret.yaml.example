# Segredo de laboratório: `k8s-blueprint secrets init -o broetec-storage` (ou o
# role 04) gera o *-secret.yaml com valores aleatórios guardados em
# env/broetec-storage/lab-secrets.yml e o sela com a chave BYOK do overlay.
# Para usar valores próprios, crie o *-secret.yaml à mão antes do deploy.
apiVersion: v1
kind: Secret
metadata:
  name: seaweedfs-s3-bootstrap-admin
  namespace: seaweedfs
type: Opaque
stringData:
  access-key: <lab:s3-admin-access-key:20>
  secret-key: <lab:s3-admin-secret-key:40>
