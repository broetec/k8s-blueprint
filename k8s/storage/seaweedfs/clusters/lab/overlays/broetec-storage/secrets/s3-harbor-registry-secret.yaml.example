# Segredo de laboratório: `k8s-blueprint secrets init -o broetec-storage` (ou o
# role 04) gera o *-secret.yaml com valores aleatórios guardados em
# env/broetec-storage/lab-secrets.yml e o sela com a chave BYOK do overlay.
# Para usar valores próprios, crie o *-secret.yaml à mão antes do deploy.
# Identidade S3 do registry do Harbor: o CronJob seaweedfs-s3-sync cria o bucket
# e a identidade a partir dos Secrets com o label seaweedfs-s3-identity.
apiVersion: v1
kind: Secret
metadata:
  name: seaweedfs-s3-harbor-registry
  namespace: seaweedfs
  labels:
    seaweedfs-s3-identity: "true"
type: Opaque
stringData:
  bucket-name: harbor-registry
  access-key: <lab:s3-harbor-registry-access-key:20>
  secret-key: <lab:s3-harbor-registry-secret-key:40>
